generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  createdAt     DateTime @default(now())
  accounts      Account[]
  transactions  Transaction[]
}

model Account {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  name      String
  type      String
  currency  String   @default("BRL")
  createdAt DateTime @default(now())
  txs       Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String
  type        String
  amountCents Int
  description String
  category    String?
  date        DateTime
  createdAt   DateTime @default(now())
}
